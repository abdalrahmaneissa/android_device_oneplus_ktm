<resources>
    <!-- Device has a physical alert slider (tri-state key) -->
    <bool name="config_hasAlertSlider">true</bool>

    <!-- Alert slider position node -->
    <string name="config_alertSliderNode">/proc/tri-state-key/position</string>

    <!--
         Alert slider positions mapped to ringer modes:
         position 1 RINGER_MODE_SILENT
         position 2 RINGER_MODE_VIBRATE
         position 3 RINGER_MODE_NORMAL
    -->
    <integer name="config_alertSliderTopPosition">1</integer>
    <integer name="config_alertSliderMiddlePosition">2</integer>
    <integer name="config_alertSliderBottomPosition">3</integer>

    <!-- Display -->
    <!-- Aspect ratio for 2800x1272 display -->
    <bool name="config_haveHigherAspectRatioScreen">true</bool>

    <!-- Supported LiveDisplay modes for this OLED panel -->
    <!-- 0=Off, 1=Auto (not available on OLED), 2=Day, 4=Night, 8=Outdoor -->
    <integer name="config_dayColorTemperature">6500</integer>
    <integer name="config_nightColorTemperature">4000</integer>
    <integer name="config_outdoorAmbientLux">12000</integer>
    <integer name="config_outdoorAmbientLuxHysteresis">1500</integer>

    <!-- OLED: disable Adaptive Backlight (handled by OLED panel controller) -->
    <bool name="config_enableCABC">false</bool>

    <!-- Color enhancement (SDR→Vivid mode) available via DisplayColorFeature HAL -->
    <bool name="config_enableColorEnhancement">true</bool>

    <!-- Auto outdoor mode supported via ambient light sensor -->
    <bool name="config_enableAutomaticBrightness">true</bool>

    <!-- Trust Interface -->
    <!-- Keys in the trust interface: Power key + Volume keys -->
    <string-array name="config_trustKeyguardKeys">
        <item>26</item>  <!-- KEYCODE_POWER -->
        <item>24</item>  <!-- KEYCODE_VOLUME_UP -->
        <item>25</item>  <!-- KEYCODE_VOLUME_DOWN -->
    </string-array>

    <!-- Advanced reboot options -->
    <string-array name="config_restartActionsList">
        <item>restart</item>
        <item>restart_recovery</item>
        <item>restart_bootloader</item>
        <item>restart_fastboot</item>
    </string-array>
</resources>
