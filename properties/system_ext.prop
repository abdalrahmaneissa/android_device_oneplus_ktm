#
# KTM-ONLY system_ext props.
# common/system_ext.prop already sets: horae, ims ovr flags,
# radio slots, netmgr, media, bluetooth, cne, gps, etc.
#

# IMS RTP logging — intentionally OFF for user builds.
# Overrides common/system_ext.prop's value of 15.
persist.vendor.ims.rtp.enableqxdm=0

# IFAA — KTM-specific device model identifier for
# the In-App Fingerprint Authentication Alliance service.
# Unique per hardware variant.
sys.oplus.ifaa.model=ONEPLUS-R24851