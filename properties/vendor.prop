#
# Vendor partition properties for OnePlus Ace 6 (ktm).
# Source: extracted vendor/build.prop from PLQ110_16.0.5.700(CN01)
#

# Audio
ro.oplus.audio.odm.para=KTM_20250926_V12
ro.oplus.audio.support.meta_audio=1
ro.oplus.audio.support.meta_audio_voip=1
ro.oplus.audio.support.meta_audio_soundbed=1
ro.oplus.audio.support.reverse_in_hal=1
ro.oplus.audio.support.mss=1
ro.oplus.audio.support.LHDC_RING=true
ro.oplus.audio.ring_output_setting_support=true

# NFC
ro.oplus.nfc.support.tee=true
ro.oplus.eid.enable.state=1
ro.oplus.nfc.frequency.support=true
ro.oplus.nfc.current.support=true
ro.oplus.nfc.support.encryption_card=true
ro.oplus.nfc.smart_switch_card=true
ro.oplus.nfc.ccc_bmw_hmi_support=true
ro.oplus.nfc.feature_disable_tag_notify=true
ro.oplus.nfc.tap_to_share_with_ios=true
ro.oplus.nfc.support.supercard=true
ro.oplus.nfc.tap_to_share_v2=true

# WiFi
ro.oplus.wifi.minidump.enable.state=1
ro.oplus.wifi.vbat.backoff.power=18
ro.oplus.wifi.sta.channel.version=39_5G
ro.oplus.wifi.wsa=StbcMrc
ro.oplus.wifi.ull.tx_bw20=true
ro.oplus.wifi.llm.media_boost=true
ro.oplus.wifi.p2p.wowlan.enable=true

# SurfaceFlinger refresh-rate scheduler
# These override sm8750-common defaults for the 165Hz OLED panel.
# Common sets: set_idle_timer_ms=80, set_touch_timer_ms=0
# KTM uses longer timers to prevent excessive mode switching on OLED.
ro.surface_flinger.set_idle_timer_ms=250
ro.surface_flinger.set_touch_timer_ms=200
ro.surface_flinger.set_display_power_timer_ms=500
ro.surface_flinger.use_content_detection_for_refresh_rate=true
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
